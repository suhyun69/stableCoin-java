# 이 파일을 .env 로 복사해 값을 채운다: cp .env.example .env
# .env 는 git에 커밋되지 않는다. 앱은 실행 디렉터리(api/)의 .env 를 읽는다.

# 노드 RPC 주소와 체인 ID (기본값: http://127.0.0.1:8545, 31337)
# CHAIN_RPC_URL=http://127.0.0.1:8545
# CHAIN_ID=31337

# 전송에 쓰는 서명 지갑의 개인키(hex, 0x로 시작하는 64자리).
# 로컬 anvil이라면 시작 로그의 "Private Keys" (0)번 값을 쓴다:
#   docker compose logs anvil | grep -A3 "Private Keys"
# 실제 자금이 있는 지갑의 키는 넣지 않는다.
CHAIN_SIGNER_PRIVATE_KEY=
